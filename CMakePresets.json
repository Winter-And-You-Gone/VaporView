{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc2022-x64-release",
      "displayName": "Windows x64 Release (MSVC 2022 + Qt 6 MSVC)",
      "description": "Build with Visual Studio 2022 MSVC, Qt 6 msvc2022_64, CMake, and Ninja.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$env{VAPORVIEW_QT_MSVC_PREFIX}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-arm64-gcc-release",
      "displayName": "Linux ARM64 Release (GCC + Qt 6)",
      "description": "Build natively on Linux ARM64 with GCC/G++, Qt 6, CMake, and Ninja.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-x64-gcc-release",
      "displayName": "Linux x64 Release (GCC + Qt 6)",
      "description": "Build natively on Linux x64 with GCC/G++, Qt 6, CMake, and Ninja.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc2022-x64-release",
      "configurePreset": "windows-msvc2022-x64-release"
    },
    {
      "name": "windows-msvc2022-x64-release-app-only",
      "configurePreset": "windows-msvc2022-x64-release",
      "targets": [
        "VaporView"
      ]
    },
    {
      "name": "linux-arm64-gcc-release",
      "configurePreset": "linux-arm64-gcc-release"
    },
    {
      "name": "linux-arm64-gcc-release-app-only",
      "configurePreset": "linux-arm64-gcc-release",
      "targets": [
        "VaporView"
      ]
    },
    {
      "name": "linux-x64-gcc-release",
      "configurePreset": "linux-x64-gcc-release"
    },
    {
      "name": "linux-x64-gcc-release-app-only",
      "configurePreset": "linux-x64-gcc-release",
      "targets": [
        "VaporView"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc2022-x64-release",
      "configurePreset": "windows-msvc2022-x64-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 180,
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-msvc2022-x64-release-fast",
      "inherits": "windows-msvc2022-x64-release",
      "displayName": "Windows x64 Release fast tests",
      "filter": {
        "include": {
          "label": "fast"
        }
      },
      "execution": {
        "timeout": 90,
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-arm64-gcc-release",
      "configurePreset": "linux-arm64-gcc-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 180,
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-arm64-gcc-release-fast",
      "inherits": "linux-arm64-gcc-release",
      "displayName": "Linux ARM64 Release fast tests",
      "filter": {
        "include": {
          "label": "fast"
        }
      },
      "execution": {
        "timeout": 90,
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-x64-gcc-release",
      "configurePreset": "linux-x64-gcc-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 180,
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-x64-gcc-release-fast",
      "inherits": "linux-x64-gcc-release",
      "displayName": "Linux x64 Release fast tests",
      "filter": {
        "include": {
          "label": "fast"
        }
      },
      "execution": {
        "timeout": 90,
        "noTestsAction": "error"
      }
    }
  ]
}
