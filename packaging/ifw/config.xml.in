<Installer>
    <Name>VaporView</Name>
    <Version>@VAPORVIEW_VERSION@</Version>
    <Title>VaporView Setup</Title>
    <Publisher>VaporView</Publisher>
    <ProductUrl>https://vaporview.example.invalid</ProductUrl>
    <WizardStyle>Modern</WizardStyle>
    <WizardDefaultWidth>600</WizardDefaultWidth>
    <WizardDefaultHeight>400</WizardDefaultHeight>
    <TargetDir>@VAPORVIEW_TARGET_DIR@</TargetDir>
    <StartMenuDir>VaporView</StartMenuDir>
    <InstallerApplicationIcon>VaporViewInstallerIcon</InstallerApplicationIcon>
    <InstallerWindowIcon>VaporViewInstallerIcon.png</InstallerWindowIcon>
    <MaintenanceToolName>VaporViewMaintenanceTool</MaintenanceToolName>
    <MaintenanceToolIniFile>VaporViewMaintenanceTool.ini</MaintenanceToolIniFile>
    <ControlScript>control.qs</ControlScript>
    <Translations>
        <Translation>ifw_zh_CN</Translation>
        <Translation>qt_zh_CN</Translation>
    </Translations>
    @VAPORVIEW_REMOTE_REPOSITORIES@
</Installer>
