<Package>
    <Name>com.vaporview.core</Name>
    <DisplayName>VaporView</DisplayName>
    <Description>VaporView desktop, Sky and 3D runtime.</Description>
    <Version>@VAPORVIEW_VERSION@</Version>
    <ReleaseDate>@VAPORVIEW_RELEASE_DATE@</ReleaseDate>
    <Default>true</Default>
    <Essential>true</Essential>
    <ForcedInstallation>true</ForcedInstallation>
    <Licenses>
        <License name="GPLv3（中文说明）" file="license.txt" />
        <License name="GPLv3 (English)" file="license_en.txt" />
    </Licenses>
    <UserInterfaces>
        <UserInterface>shortcutselection.ui</UserInterface>
    </UserInterfaces>
    <Script>installscript.qs</Script>
</Package>
