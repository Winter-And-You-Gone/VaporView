if(NOT DEFINED VAPORVIEW_RUNTIME_TARGET)
    message(FATAL_ERROR "VAPORVIEW_RUNTIME_TARGET is not defined")
endif()

if(POLICY CMP0207)
    cmake_policy(SET CMP0207 NEW)
endif()

if(NOT DEFINED VAPORVIEW_RUNTIME_DESTINATION)
    message(FATAL_ERROR "VAPORVIEW_RUNTIME_DESTINATION is not defined")
endif()

set(vaporview_runtime_target "${VAPORVIEW_RUNTIME_TARGET}")
set(vaporview_runtime_destination "${VAPORVIEW_RUNTIME_DESTINATION}")
set(vaporview_runtime_search_dirs
    "@MINGW_RUNTIME_DIR@"
    "@QT_RUNTIME_DIR@"
)

set(vaporview_existing_search_dirs)
foreach(vaporview_search_dir IN LISTS vaporview_runtime_search_dirs)
    if(EXISTS "${vaporview_search_dir}")
        list(APPEND vaporview_existing_search_dirs "${vaporview_search_dir}")
    endif()
endforeach()

if(NOT EXISTS "${vaporview_runtime_target}")
    message(FATAL_ERROR "Runtime target does not exist: ${vaporview_runtime_target}")
endif()

file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES "${vaporview_runtime_target}"
    RESOLVED_DEPENDENCIES_VAR vaporview_resolved_deps
    UNRESOLVED_DEPENDENCIES_VAR vaporview_unresolved_deps
    DIRECTORIES ${vaporview_existing_search_dirs}
    POST_EXCLUDE_REGEXES
        ".*[Ww]indows[\\\\/][Ss]ystem32[\\\\/].*"
        ".*[Ww]indows[\\\\/]SysWOW64[\\\\/].*"
        ".*WindowsApps[\\\\/].*"
        "api-ms-win-.*"
        "ext-ms-.*"
)

foreach(vaporview_dependency IN LISTS vaporview_resolved_deps)
    file(COPY "${vaporview_dependency}" DESTINATION "${vaporview_runtime_destination}")
endforeach()

if(vaporview_unresolved_deps)
    list(FILTER vaporview_unresolved_deps EXCLUDE REGEX "^(api-ms-win-|ext-ms-)")
    list(FILTER vaporview_unresolved_deps EXCLUDE REGEX ".*[Ww]indows[\\\\/][Ss]ystem32[\\\\/].*")
endif()

if(vaporview_unresolved_deps)
    list(JOIN vaporview_unresolved_deps "\n  " vaporview_unresolved_list)
    message(WARNING "Unresolved runtime dependencies:\n  ${vaporview_unresolved_list}")
endif()
