/*
 * Fluent-inspired light theme for VaporView
 * Based on the visual language used by zhuzichu520/FluentUI
 */

* {
    font-family: "Segoe UI Variable", "Segoe UI", "Microsoft YaHei", "PingFang SC", sans-serif;
    color: #111111;
}

QMainWindow,
QDialog,
QWidget#windowSurface {
    background-color: #ededed;
}

QMenuBar {
    background-color: rgba(243, 243, 243, 0.94);
    border: none;
    border-bottom: 1px solid #dadada;
    padding: 6px 10px 4px 10px;
    spacing: 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 7px 12px;
    border-radius: 8px;
    color: #1f1f1f;
}

QMenuBar::item:selected {
    background-color: rgba(0, 0, 0, 0.035);
}

QMenuBar::item:pressed {
    background-color: rgba(0, 0, 0, 0.06);
}

QMenu {
    background-color: #fcfcfc;
    border: 1px solid #dbdbdb;
    border-radius: 12px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 28px 8px 12px;
    border-radius: 8px;
    color: #1f1f1f;
}

QMenu::item:selected {
    background-color: rgba(0, 120, 212, 0.10);
    color: #003e73;
}

QMenu::separator {
    height: 1px;
    margin: 6px 8px;
    background-color: #e6e6e6;
}

QToolBar#topCommandBar {
    background-color: rgba(243, 243, 243, 0.94);
    border: none;
    border-bottom: 1px solid #dadada;
    spacing: 6px;
    padding: 8px 10px;
}

QToolBar#topCommandBar QToolButton {
    background-color: transparent;
    color: #1f1f1f;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 14px;
    min-height: 34px;
}

QToolBar#topCommandBar QToolButton:hover {
    background-color: rgba(0, 0, 0, 0.035);
    border-color: rgba(0, 0, 0, 0.04);
}

QToolBar#topCommandBar QToolButton:pressed,
QToolBar#topCommandBar QToolButton:checked {
    background-color: rgba(0, 0, 0, 0.07);
    border-color: rgba(0, 0, 0, 0.05);
}

QToolBar#topCommandBar QToolButton:disabled {
    color: #9a9a9a;
}

QToolBar#topCommandBar::separator {
    width: 1px;
    margin: 6px 4px;
    background-color: #dddddd;
}

QStatusBar {
    background-color: rgba(243, 243, 243, 0.94);
    border: none;
    border-top: 1px solid #dadada;
    padding: 6px 10px;
}

QStatusBar::item {
    border: none;
}

QGroupBox,
QGroupBox#cardSurface,
QGroupBox#sensorGroupBox {
    background-color: rgba(252, 252, 252, 0.96);
    border: 1px solid #dddddd;
    border-radius: 16px;
    margin-top: 10px;
    padding: 10px;
    font-size: 15px;
    font-weight: 600;
    color: #111111;
}

QGroupBox#sensorGroupBox {
    margin-top: 0px;
    padding: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 16px;
    top: -2px;
    padding: 0px 6px;
    color: #1f1f1f;
    background-color: #ededed;
}

QLabel {
    color: #111111;
    background-color: transparent;
    border: none;
}

QLabel#sectionTitleLabel {
    color: #111111;
    font-size: 17px;
    font-weight: 650;
    padding: 4px 0px 6px 0px;
}

QLabel#fieldLabel {
    color: #616161;
    font-size: 13px;
    font-weight: 600;
}

QLabel#valueLabel {
    color: #111111;
    font-family: "Cascadia Mono", "Consolas", "Courier New", monospace;
    font-size: 13px;
    font-weight: 600;
}

QLabel#rateLabel,
QLabel#rateBadge {
    color: #4f4f4f;
    background-color: #f3f3f3;
    border: 1px solid #e2e2e2;
    border-radius: 10px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
}

QLabel#separatorLabel {
    color: #525252;
    font-size: 12px;
    font-weight: 700;
    padding-top: 6px;
}

QLabel#highlightedValue {
    color: #005fb8;
    background-color: rgba(0, 120, 212, 0.10);
    border: 1px solid rgba(0, 120, 212, 0.18);
    border-radius: 10px;
    padding: 6px 10px;
    font-size: 14px;
    font-weight: 700;
}

QLabel#statusIndicator {
    color: #3a3a3a;
    background-color: #f3f3f3;
    border: 1px solid #e2e2e2;
    border-radius: 10px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 700;
}

QLabel#statusIndicator[status="connected"] {
    color: #0f6a0f;
    background-color: rgba(16, 124, 16, 0.10);
    border-color: rgba(16, 124, 16, 0.18);
}

QLabel#statusIndicator[status="connecting"] {
    color: #8a4d00;
    background-color: rgba(247, 99, 12, 0.11);
    border-color: rgba(247, 99, 12, 0.18);
}

QLabel#statusIndicator[status="disconnected"] {
    color: #a4262c;
    background-color: rgba(232, 17, 35, 0.09);
    border-color: rgba(232, 17, 35, 0.16);
}

QLabel[data-valid="true"] {
    color: #0f6a0f;
}

QLabel[data-valid="false"] {
    color: #a4262c;
}

QPushButton {
    background-color: #fbfbfb;
    color: #1f1f1f;
    border: 1px solid #d8d8d8;
    border-radius: 10px;
    padding: 0px 16px;
    font-size: 14px;
    font-weight: 600;
    min-height: 38px;
    max-height: 38px;
}

QPushButton:hover {
    background-color: #f6f6f6;
    border-color: #cccccc;
}

QPushButton:pressed {
    background-color: #efefef;
    border-color: #c8c8c8;
}

QPushButton:disabled {
    background-color: #f7f7f7;
    color: #aaaaaa;
    border-color: #e3e3e3;
}

QPushButton#accentButton,
QPushButton#compactTcpStartButton {
    background-color: #0078d4;
    color: #ffffff;
    border: 1px solid #0070c8;
}

QPushButton#accentButton:hover,
QPushButton#compactTcpStartButton:hover {
    background-color: #006cbe;
    border-color: #0064b0;
}

QPushButton#accentButton:pressed,
QPushButton#compactTcpStartButton:pressed {
    background-color: #005ea6;
    border-color: #005595;
}

QPushButton#secondaryButton,
QPushButton#compactTcpButton {
    background-color: rgba(0, 0, 0, 0.03);
    border-color: rgba(0, 0, 0, 0.06);
}

QPushButton#secondaryButton:hover,
QPushButton#compactTcpButton:hover {
    background-color: rgba(0, 0, 0, 0.055);
}

QPushButton#secondaryButton:pressed,
QPushButton#compactTcpButton:pressed {
    background-color: rgba(0, 0, 0, 0.08);
}

QPushButton#dangerButton {
    color: #a4262c;
    background-color: rgba(232, 17, 35, 0.06);
    border-color: rgba(232, 17, 35, 0.14);
}

QPushButton#dangerButton:hover {
    background-color: rgba(232, 17, 35, 0.10);
}

QPushButton#dangerButton:pressed {
    background-color: rgba(232, 17, 35, 0.14);
}

QLineEdit,
QTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QTableWidget {
    background-color: #ffffff;
    color: #111111;
    border: 1px solid #d2d2d2;
    border-radius: 10px;
}

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    min-height: 32px;
    padding: 4px 10px;
    font-size: 14px;
}

QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QComboBox:hover,
QTextEdit:hover,
QTableWidget:hover {
    border-color: #c4c4c4;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus,
QTextEdit:focus,
QTableWidget:focus {
    border: 2px solid #0078d4;
}

QLineEdit[readOnly="true"] {
    background-color: #f7f7f7;
    color: #4f4f4f;
}

QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled {
    background-color: #f7f7f7;
    color: #9a9a9a;
    border-color: #e2e2e2;
}

QComboBox::drop-down {
    width: 28px;
    border: none;
}

QComboBox::down-arrow {
    image: url(combo_arrow_down.xpm);
    width: 12px;
    height: 8px;
    margin-right: 8px;
}

QComboBox QAbstractItemView,
QAbstractItemView {
    background-color: #fcfcfc;
    border: 1px solid #d6d6d6;
    border-radius: 10px;
    outline: none;
    selection-background-color: rgba(0, 120, 212, 0.12);
    selection-color: #003e73;
    padding: 4px;
}

QComboBox QAbstractItemView::item,
QAbstractItemView::item {
    min-height: 28px;
    border-radius: 8px;
    padding: 4px 8px;
}

QComboBox QAbstractItemView::item:hover,
QAbstractItemView::item:hover {
    background-color: rgba(0, 0, 0, 0.04);
}

QSpinBox,
QDoubleSpinBox {
    padding: 4px 28px 4px 10px;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    width: 20px;
    border: none;
    background-color: transparent;
    subcontrol-origin: border;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 10px;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 10px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: rgba(0, 0, 0, 0.04);
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(combo_arrow_up.xpm);
    width: 12px;
    height: 8px;
    margin-right: 6px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(combo_arrow_down.xpm);
    width: 12px;
    height: 8px;
    margin-right: 6px;
}

QTextEdit {
    padding: 10px 12px;
    selection-background-color: rgba(0, 120, 212, 0.26);
    selection-color: #111111;
    font-size: 13px;
}

QTextEdit#logConsole,
QTextEdit#monitorConsole {
    background-color: #1f1f1f;
    color: #f3f3f3;
    border: 1px solid #3a3a3a;
    font-family: "Cascadia Mono", "Consolas", "Courier New", monospace;
}

QTextEdit#logConsole:focus,
QTextEdit#monitorConsole:focus {
    border: 1px solid #4f4f4f;
}

QTableWidget {
    gridline-color: #e7e7e7;
    alternate-background-color: #f8f8f8;
    selection-background-color: rgba(0, 120, 212, 0.12);
    selection-color: #111111;
}

QHeaderView::section {
    background-color: #f6f6f6;
    color: #3a3a3a;
    border: none;
    border-bottom: 1px solid #dddddd;
    padding: 8px 10px;
    font-size: 13px;
    font-weight: 650;
}

QTableCornerButton::section {
    background-color: #f6f6f6;
    border: none;
    border-bottom: 1px solid #dddddd;
    border-right: 1px solid #dddddd;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    margin: 4px 0px;
}

QScrollBar::handle:vertical {
    background-color: rgba(0, 0, 0, 0.16);
    min-height: 36px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(0, 0, 0, 0.25);
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
    margin: 0px 4px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(0, 0, 0, 0.16);
    min-width: 36px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(0, 0, 0, 0.25);
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
    width: 0px;
    height: 0px;
}

QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:horizontal {
    width: 10px;
}

QSplitter::handle:vertical {
    height: 10px;
}

QSplitter::handle:hover {
    background-color: rgba(0, 120, 212, 0.08);
}

QToolTip {
    background-color: #1f1f1f;
    color: #ffffff;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
}

QMessageBox {
    background-color: #ededed;
}

QCheckBox,
QRadioButton {
    color: #1f1f1f;
    spacing: 8px;
    font-size: 14px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #8a8a8a;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #0078d4;
}

QCheckBox::indicator:checked {
    background-color: #0078d4;
    border-color: #0078d4;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #8a8a8a;
    border-radius: 9px;
    background-color: #ffffff;
}

QRadioButton::indicator:hover {
    border-color: #0078d4;
}

QRadioButton::indicator:checked {
    border: 5px solid #0078d4;
}
