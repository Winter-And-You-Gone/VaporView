<map name="VaporView Full Local Map Safe Default + SRTM">
    <!-- Offline global visual background. This is not terrain elevation. -->
    <GDALImage name="Natural Earth II 1:50m shaded relief with water">
        <url>natural_earth/NE2_50M_SR_W/NE2_50M_SR_W.vrt</url>
        <interpolation>bilinear</interpolation>
    </GDALImage>

    <!-- Backup local elevation layer. Build this from local SRTM GeoTIFF tiles. -->
    <GDALElevation name="SRTM local GeoTIFF elevation">
        <url>terrain/srtm/srtm.vrt</url>
        <interpolation>bilinear</interpolation>
    </GDALElevation>

    <!--
        Local OSM vector GeoPackages prepared by scripts/prepare-osm-local-data.py.

        Safety note:
        full-country OSM extracts can contain a very large number of place labels
        and building polygons. Loading those as osgEarth text/model layers can show
        missing font glyph boxes on CJK names and can stall the render thread when
        zooming. The automatic full-local template therefore renders only light
        draped context layers by default.
    -->
    <OGRFeatures name="osm-water">
        <url>osm/water.gpkg</url>
    </OGRFeatures>

    <OGRFeatures name="osm-roads">
        <url>osm/roads.gpkg</url>
    </OGRFeatures>

    <FeatureImage name="OSM water fill" min_level="6">
        <features>osm-water</features>
        <styles>
            <style type="text/css">
                default {
                    fill:         #3f86b9;
                    stroke:       #76b9df;
                    stroke-width: 1px;
                }
            </style>
        </styles>
    </FeatureImage>

    <FeatureImage name="OSM roads" min_level="8">
        <features>osm-roads</features>
        <styles>
            <style type="text/css">
                default {
                    stroke:       #f6df8f;
                    stroke-width: 2px;
                }
            </style>
        </styles>
    </FeatureImage>
</map>
